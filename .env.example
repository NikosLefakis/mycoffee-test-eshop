# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (Neon via Vercel Storage). Required.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public URL of the shop, used for canonical links, sitemap and robots.txt.
# Set it before building for production. Optional locally.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
